{
  "manifest_version": 3,
  "name": "SVG to Slides",
  "version": "0.1.0",
  "description": "Convert SVGs to editable PPTX, or paste them straight into Google Slides.",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://svg-to-slides-jwxfsrfexq-uc.a.run.app/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/presentation/d/*/edit*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
