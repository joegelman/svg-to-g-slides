{
  "manifest_version": 3,
  "name": "SVG to Slides",
  "version": "1.4.3",
  "description": "Import, edit, combine and draw vector graphics natively in Google Slides™.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/d/*/edit*"
      ],
      "js": [
        "shared.js",
        "svg-convert.js",
        "slides-bridge.js",
        "rail-kit.js",
        "content.js",
        "svg-editor.js",
        "geo-ops.js",
        "fontkit.js",
        "shape-tools.js",
        "whats-new.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ]
}
